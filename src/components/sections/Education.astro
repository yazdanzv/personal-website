---
import { profile } from '../../config/profile';
const assetHref = (value: string) => `${import.meta.env.BASE_URL}${value.replace(/^\/+/, '')}`;
---

<section id="education" class="section-rule py-20 md:py-24">
  <div class="page-shell grid gap-12 lg:grid-cols-[0.35fr_1fr]">
    <p class="section-index" data-reveal>05 · Foundations</p>
    <div class="grid gap-10" data-reveal>
      <div>
        <p class="font-mono text-[10px] uppercase tracking-[0.15em] text-ink-400">Education</p>
        <h2 class="mt-4 text-3xl font-medium text-ink-100 md:text-5xl">{profile.education[0].institution}</h2>
        <div class="mt-5 flex flex-col gap-2 text-base text-ink-300 sm:flex-row sm:items-center sm:justify-between">
          <span>{profile.education[0].degree}</span><span class="font-mono text-xs">{profile.education[0].period} · {profile.education[0].location}</span>
        </div>
      </div>
      <div class="grid gap-6 border-t border-line/20 pt-8 md:grid-cols-2">
        <div>
          <p class="font-mono text-[10px] uppercase tracking-[0.15em] text-signal">Recognition · {profile.achievements[0].year}</p>
          <h3 class="mt-3 text-xl font-medium text-ink-100">{profile.achievements[0].title}</h3>
          <a href={assetHref(profile.achievements[0].href)} download="Faculty-of-Engineering-Award.pdf" class="tap-target mt-4 inline-flex items-center border-b border-line/30 text-sm text-ink-300 hover:border-accent-300 hover:text-accent-300">{profile.achievements[0].linkLabel}</a>
        </div>
        <div>
          <p class="font-mono text-[10px] uppercase tracking-[0.15em] text-ink-400">Languages</p>
          <div class="mt-3 flex flex-wrap gap-x-6 gap-y-3 text-sm text-ink-300">
            {profile.languages.map((item) => <span><strong class="font-medium text-ink-100">{item.language}</strong> · {item.detail}</span>)}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
