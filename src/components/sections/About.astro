---
import { profile } from '../../config/profile';
---

<section id="about" class="section-rule py-20 md:py-28">
  <div class="page-shell grid gap-10 lg:grid-cols-[0.35fr_1fr]">
    <p class="section-index" data-reveal>06 · About</p>
    <div data-reveal>
      <h2 class="max-w-4xl text-balance text-4xl font-medium text-ink-100 md:text-6xl">{profile.about.title}</h2>
      <p class="mt-6 max-w-3xl text-xl leading-8 text-accent-300">{profile.about.subtitle}</p>
      <div class="mt-10 grid gap-6 border-t border-line/20 pt-8 md:grid-cols-3">
        {profile.about.paragraphs.map((paragraph, index) => (
          <div>
            <span class="font-mono text-[10px] text-ink-400">0{index + 1}</span>
            <p class="mt-4 text-base leading-8 text-ink-300">{paragraph}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
