---
import { profile } from '../../config/profile';
---

<section class="section-rule bg-paper py-20 text-surface-950 md:py-28">
  <div class="page-shell grid gap-14 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
    <div data-reveal>
      <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-[#1d6e68]">{profile.engineeringPrinciple.label}</p>
      <h2 class="mt-5 text-balance text-4xl font-medium leading-[1.05] md:text-6xl">{profile.engineeringPrinciple.title}</h2>
      <div class="mt-7 max-w-xl space-y-5 text-base leading-8 text-surface-600">
        {profile.engineeringPrinciple.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>

    <figure class="technical-grid border border-surface-950/20 bg-[#e3ded2] p-5 sm:p-8" data-reveal style="--reveal-delay:100ms">
      <figcaption class="mb-8 flex items-center justify-between gap-4 font-mono text-[10px] uppercase tracking-[0.15em] text-surface-600">
        <span>Controlled coexistence</span><span>Migration pattern · 01</span>
      </figcaption>
      <svg viewBox="0 0 660 350" role="img" aria-labelledby="coexistence-title coexistence-desc" class="w-full">
        <title id="coexistence-title">Controlled coexistence migration pattern</title>
        <desc id="coexistence-desc">Legacy and modern systems connect through a compatibility boundary during incremental migration.</desc>
        <defs><marker id="arrow" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"><path d="M0 0L8 4L0 8Z" fill="#1d6e68" /></marker></defs>
        <rect x="20" y="62" width="170" height="94" fill="#101312" />
        <text x="42" y="100" fill="#ebe6da" font-family="IBM Plex Mono" font-size="13">LEGACY SYSTEM</text>
        <text x="42" y="128" fill="#aaa9a2" font-family="IBM Plex Sans" font-size="14">Existing behavior</text>
        <rect x="245" y="40" width="170" height="138" fill="#55b8ad" />
        <text x="267" y="86" fill="#101312" font-family="IBM Plex Mono" font-size="13">COMPATIBILITY</text>
        <text x="267" y="108" fill="#101312" font-family="IBM Plex Mono" font-size="13">BOUNDARY</text>
        <text x="267" y="143" fill="#1a3d39" font-family="IBM Plex Sans" font-size="14">Contracts · adapters</text>
        <rect x="470" y="62" width="170" height="94" fill="#d76549" />
        <text x="492" y="100" fill="#101312" font-family="IBM Plex Mono" font-size="13">MODERN SYSTEM</text>
        <text x="492" y="128" fill="#3f241d" font-family="IBM Plex Sans" font-size="14">New architecture</text>
        <path d="M190 109H237" stroke="#1d6e68" stroke-width="3" marker-end="url(#arrow)" />
        <path d="M415 109H462" stroke="#1d6e68" stroke-width="3" marker-end="url(#arrow)" />
        <path d="M555 176C555 268 105 268 105 176" fill="none" stroke="#6f746e" stroke-width="2" stroke-dasharray="7 7" marker-end="url(#arrow)" />
        <text x="214" y="292" fill="#4a514d" font-family="IBM Plex Mono" font-size="12">INCREMENTAL MIGRATION · OBSERVE · VERIFY · REPEAT</text>
      </svg>
    </figure>
  </div>
</section>
