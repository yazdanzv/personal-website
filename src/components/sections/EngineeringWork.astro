---
import { profile } from '../../config/profile';
---

<section id="engineering" class="section-rule py-20 md:py-28">
  <div class="page-shell">
    <header class="grid gap-6 lg:grid-cols-[0.35fr_1fr]" data-reveal>
      <p class="section-index">03 · Engineering</p>
      <div>
        <h2 class="max-w-4xl text-balance text-4xl font-medium leading-tight text-ink-100 md:text-6xl">Selected engineering work</h2>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-ink-300">Areas of responsibility from production work on mature enterprise systems.</p>
      </div>
    </header>

    <div class="mt-14 border-t border-line/20">
      {profile.engineeringCases.map((item, index) => (
        <article class="grid gap-5 border-b border-line/20 py-8 md:grid-cols-[5rem_0.8fr_1.2fr] md:gap-8 md:py-10" data-reveal style={`--reveal-delay:${index * 50}ms`}>
          <p class={`font-mono text-xs ${item.tone === 'red' ? 'text-signal' : item.tone === 'sand' ? 'text-ink-300' : 'text-accent-300'}`}>{item.number}</p>
          <div>
            <h3 class="text-2xl font-medium text-ink-100 md:text-3xl">{item.title}</h3>
          </div>
          <div>
            <p class="max-w-2xl text-base leading-8 text-ink-200">{item.approach}</p>
            <div class="mt-5 flex flex-wrap gap-x-5 gap-y-2">
              {item.technologies.map((technology) => <span class="font-mono text-xs text-ink-400">{technology}</span>)}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
