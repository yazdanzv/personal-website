---
import { profile } from '../../config/profile';
---

<section id="engineering" class="section-rule py-20 md:py-28">
  <div class="page-shell">
    <header class="grid gap-6 lg:grid-cols-[0.35fr_1fr]" data-reveal>
      <p class="section-index">01 · Engineering</p>
      <div>
        <h2 class="max-w-4xl text-balance text-4xl font-medium leading-tight text-ink-100 md:text-6xl">What I build—and how I move systems forward.</h2>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-ink-300">Selected work from mature enterprise systems. The details stay intentionally architectural: enough to show the decisions without exposing proprietary code or business rules.</p>
      </div>
    </header>

    <div class="mt-14 grid gap-px overflow-hidden border border-white/10 bg-white/10 lg:grid-cols-2">
      {profile.engineeringCases.map((item, index) => (
        <article class="group bg-surface-950 p-6 transition hover:bg-surface-900 md:p-8" data-reveal style={`--reveal-delay:${index * 60}ms`}>
          <div class="flex items-start justify-between gap-5">
            <span class={`font-mono text-xs ${item.tone === 'red' ? 'text-signal' : item.tone === 'sand' ? 'text-[#d8bd83]' : 'text-accent-300'}`}>{item.number}</span>
            <span class="h-2 w-2 border border-white/30 transition group-hover:border-accent-300 group-hover:bg-accent-300" aria-hidden="true"></span>
          </div>
          <h3 class="mt-8 text-2xl font-medium text-ink-100 md:text-3xl">{item.title}</h3>
          <p class="mt-3 max-w-xl text-base leading-7 text-ink-300">{item.summary}</p>

          <dl class="mt-8 grid gap-5 border-t border-white/10 pt-6">
            <div class="grid gap-2 sm:grid-cols-[6rem_1fr]">
              <dt class="font-mono text-[10px] uppercase tracking-[0.15em] text-ink-400">Problem</dt>
              <dd class="text-sm leading-6 text-ink-200">{item.problem}</dd>
            </div>
            <div class="grid gap-2 sm:grid-cols-[6rem_1fr]">
              <dt class="font-mono text-[10px] uppercase tracking-[0.15em] text-ink-400">Approach</dt>
              <dd class="text-sm leading-6 text-ink-200">{item.approach}</dd>
            </div>
            <div class="grid gap-2 sm:grid-cols-[6rem_1fr]">
              <dt class="font-mono text-[10px] uppercase tracking-[0.15em] text-ink-400">Outcome</dt>
              <dd class="text-sm leading-6 text-ink-200">{item.outcome}</dd>
            </div>
          </dl>

          <div class="mt-7 flex flex-wrap gap-x-4 gap-y-2 border-t border-white/10 pt-5">
            {item.technologies.map((technology) => <span class="font-mono text-[11px] text-ink-400">{technology}</span>)}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
