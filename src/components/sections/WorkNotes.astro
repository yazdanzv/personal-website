---
import { profile } from '../../config/profile';
const resolveAssetUrl = (value: string) => new URL(value.replace(/^\/+/, ''), Astro.url).href;
---

<section class="section-rule py-20 md:py-28">
  <div class="page-shell">
    <div class="grid gap-4 lg:grid-cols-[1.65fr_0.75fr] lg:items-end">
      <figure class="border border-line/20 bg-surface-900" data-reveal>
        <img src={resolveAssetUrl(profile.workPhotos[0].src)} alt={profile.workPhotos[0].alt} width="2048" height="1365" loading="lazy" class="aspect-[16/10] w-full object-cover object-center" />
        <figcaption class="border-t border-line/20 px-5 py-4 text-sm leading-6 text-ink-300">
          {profile.workPhotos[0].caption}
        </figcaption>
      </figure>
      <div class="grid gap-4" data-reveal style="--reveal-delay:100ms">
        <div class="border-l-2 border-signal pl-5">
          <p class="section-index text-signal">Work notes</p>
          <p class="mt-4 text-xl leading-8 text-ink-200">Modernization is collaborative: architecture, shared context, code review, and patient change all matter.</p>
        </div>
        <figure class="hidden overflow-hidden border border-line/20 bg-surface-900 sm:block">
          <img src={resolveAssetUrl(profile.workPhotos[1].src)} alt={profile.workPhotos[1].alt} width="1080" height="1350" loading="lazy" class="aspect-[4/5] w-full object-cover object-center" />
        </figure>
      </div>
    </div>
  </div>
</section>
