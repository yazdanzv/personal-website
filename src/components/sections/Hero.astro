---
import { profile } from '../../config/profile';
import ActionButton from '../ui/ActionButton.astro';
import SocialLink from '../ui/SocialLink.astro';
const resolveAssetUrl = (value: string) => new URL(value.replace(/^\/+/, ''), Astro.url).href;
---

<section id="home" class="relative py-14 sm:py-20 lg:py-28">
  <div class="page-shell grid gap-12 lg:grid-cols-[1.2fr_0.8fr] lg:items-end">
    <div data-reveal>
      <div class="mb-8 flex items-center gap-4">
        <span class="section-index">Full-stack software engineer</span>
        <span class="h-px flex-1 bg-white/10"></span>
        <span class="hidden font-mono text-[10px] uppercase tracking-[0.14em] text-ink-400 sm:block">Vienna · AT</span>
      </div>

      <h1 class="max-w-5xl text-balance text-[clamp(3.3rem,8vw,7.3rem)] font-medium leading-[0.88] text-ink-100">
        Yazdan Zandiye <span class="text-accent-300">Vakili.</span>
      </h1>

      <p class="mt-8 max-w-3xl text-balance text-xl leading-8 text-ink-200 md:text-2xl md:leading-10">
        {profile.hero.intro}
      </p>
      <p class="mt-5 max-w-2xl text-base leading-8 text-ink-300">{profile.hero.subline}</p>

      <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        {profile.hero.primaryActions.map((action) => (
          <ActionButton
            href={action.href === 'cv.pdf' ? `${import.meta.env.BASE_URL}${action.href}` : action.href}
            label={action.label}
            variant={action.variant}
            icon={action.icon}
            external={action.external}
            download={action.download}
          />
        ))}
      </div>

      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
        {profile.hero.socialActions.map((social) => <SocialLink {...social} />)}
      </div>
    </div>

    <aside class="relative" data-reveal style="--reveal-delay:100ms">
      <div class="relative ml-auto max-w-md">
        <div class="absolute -left-5 top-8 z-10 hidden border border-signal/50 bg-surface-950 px-3 py-2 font-mono text-[10px] uppercase tracking-[0.14em] text-signal sm:block">Distributed systems</div>
        <div class="overflow-hidden border border-white/15 bg-surface-900 p-3">
          <img src={resolveAssetUrl(profile.photo.src)} alt={profile.photo.alt} width="1280" height="1280" loading="eager" fetchpriority="high" class="aspect-[4/5] w-full object-cover object-center grayscale-[12%]" />
        </div>
        <div class="grid grid-cols-[1fr_auto] gap-5 border-x border-b border-white/15 px-4 py-4">
          <p class="text-sm leading-6 text-ink-300">{profile.hero.status}</p>
          <span class="mt-2 h-2 w-2 bg-accent-300" aria-hidden="true"></span>
        </div>
      </div>
    </aside>
  </div>

  <div class="page-shell mt-14 grid border-y border-white/10 sm:grid-cols-2 lg:grid-cols-4" data-reveal>
    {profile.hero.focus.map((item, index) => (
      <div class="flex items-center gap-3 border-white/10 px-4 py-4 sm:border-r lg:last:border-r-0">
        <span class="font-mono text-[10px] text-ink-400">0{index + 1}</span>
        <span class="text-sm text-ink-200">{item}</span>
      </div>
    ))}
  </div>
</section>
