---
import { profile } from '../../config/profile';
import type { PublicationEntry } from '../../config/profile';
import { icons } from '../../lib/icons';

const primaryPaper = profile.research.featured[0];
const secondaryPapers: PublicationEntry[] = [
  ...profile.research.featured.slice(1),
  ...profile.research.all,
];
const visualSecondary = secondaryPapers.find((paper) => paper.figure);
const visibleSecondary = [secondaryPapers[0], visualSecondary].filter(Boolean) as PublicationEntry[];
const additionalSecondary = secondaryPapers.filter((paper) => !visibleSecondary.includes(paper));
const resolveAssetUrl = (value: string) => new URL(value.replace(/^\/+/, ''), Astro.url).href;
---

<section id="research" class="section-rule py-20 md:py-28">
  <div class="page-shell">
    <header class="grid gap-6 lg:grid-cols-[0.35fr_1fr]" data-reveal>
      <p class="section-index">02 · Research</p>
      <div>
        <h2 class="max-w-4xl text-balance text-4xl font-medium leading-tight text-ink-100 md:text-6xl">
          Research, with evidence.
        </h2>
        <p class="mt-6 max-w-3xl text-lg leading-8 text-ink-300">{profile.research.intro}</p>
        <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm">
          {profile.publications.stats.map((stat) => (
            <span><strong class="font-mono font-medium text-ink-100">{stat.value}</strong> <span class="text-ink-300">{stat.label}</span></span>
          ))}
          <a href={profile.links.scholar} target="_blank" rel="noreferrer" class="tap-target inline-flex items-center border-b border-accent-300/50 text-accent-300">
            Google Scholar
          </a>
        </div>
      </div>
    </header>

    <article class="editorial-panel mt-14 overflow-hidden" data-reveal>
      <div class="grid lg:grid-cols-[0.78fr_1.22fr]">
        <div class="border-b border-line/20 bg-paper p-6 text-surface-950 md:p-9 lg:border-b-0 lg:border-r">
          <p class="font-mono text-xs uppercase tracking-[0.13em]">Primary research case</p>
          <p class="mt-8 font-mono text-6xl font-medium leading-none md:text-8xl">{primaryPaper.citationCount}</p>
          <p class="mt-3 max-w-xs text-sm leading-6">Google Scholar citations</p>

          <dl class="mt-10 grid gap-5 border-t border-surface-950/25 pt-6 text-sm leading-6">
            <div>
              <dt class="font-mono text-xs uppercase tracking-[0.12em]">Published</dt>
              <dd class="mt-1">{primaryPaper.year} · {primaryPaper.venue}</dd>
            </div>
            <div>
              <dt class="font-mono text-xs uppercase tracking-[0.12em]">Role</dt>
              <dd class="mt-1">{primaryPaper.authorRole}</dd>
            </div>
            <div>
              <dt class="font-mono text-xs uppercase tracking-[0.12em]">Record</dt>
              <dd class="mt-1">Pages {primaryPaper.pages} · DOI {primaryPaper.doi}</dd>
            </div>
          </dl>
        </div>

        <div class="min-w-0 p-6 md:p-9 lg:p-12">
          <p class="font-mono text-xs uppercase tracking-[0.13em] text-signal">Highest-cited publication</p>
          <h3 class="mt-5 max-w-3xl text-balance text-3xl font-medium leading-tight text-ink-100 md:text-5xl">
            {primaryPaper.title}
          </h3>
          <p class="mt-5 max-w-3xl text-base leading-8 text-ink-300">{primaryPaper.summary}</p>

          {primaryPaper.figure && (
            <figure class="mt-8 border border-line/20 bg-white p-3">
              <a href={resolveAssetUrl(primaryPaper.figure.src)} target="_blank" rel="noreferrer" aria-label="Open the DistilBERT figure at full size" class="block">
                <img
                  src={resolveAssetUrl(primaryPaper.figure.src)}
                  alt={primaryPaper.figure.alt}
                  width={primaryPaper.figure.width}
                  height={primaryPaper.figure.height}
                  loading="lazy"
                  class="mx-auto h-auto w-full max-w-2xl object-contain"
                />
              </a>
              <figcaption class="flex flex-wrap justify-between gap-x-4 border-t border-black/15 px-2 pt-3 text-xs leading-5 text-neutral-700">
                <span>{primaryPaper.figure.caption}</span>
                <a href={resolveAssetUrl(primaryPaper.figure.src)} target="_blank" rel="noreferrer" class="inline-flex min-h-11 items-center font-medium underline">Open full size</a>
              </figcaption>
            </figure>
          )}

          <dl class="mt-8 grid gap-6 border-t border-line/20 pt-7 sm:grid-cols-2">
            <div>
              <dt class="font-mono text-xs uppercase tracking-[0.13em] text-accent-300">Problem</dt>
              <dd class="mt-3 text-sm leading-7 text-ink-200">{primaryPaper.problem}</dd>
            </div>
            <div>
              <dt class="font-mono text-xs uppercase tracking-[0.13em] text-accent-300">Approach</dt>
              <dd class="mt-3 text-sm leading-7 text-ink-200">{primaryPaper.approach}</dd>
            </div>
            <div>
              <dt class="font-mono text-xs uppercase tracking-[0.13em] text-accent-300">Contribution</dt>
              <dd class="mt-3 text-sm leading-7 text-ink-200">{primaryPaper.contribution}</dd>
            </div>
            <div>
              <dt class="font-mono text-xs uppercase tracking-[0.13em] text-accent-300">Results / impact</dt>
              <dd class="mt-3 text-sm leading-7 text-ink-200">{primaryPaper.result}</dd>
            </div>
          </dl>

          <div class="mt-9 flex flex-wrap gap-x-6 gap-y-2 border-t border-line/20 pt-6 text-sm">
            <a href={primaryPaper.url} target="_blank" rel="noreferrer" class="tap-target inline-flex items-center gap-2 border-b border-line/35 text-ink-100 transition hover:border-accent-300 hover:text-accent-300">
              <span>IEEE Xplore</span><span class="size-4" set:html={icons.external}></span>
            </a>
            <a href={primaryPaper.doiUrl} target="_blank" rel="noreferrer" class="tap-target inline-flex items-center gap-2 border-b border-line/35 text-ink-100 transition hover:border-accent-300 hover:text-accent-300">
              <span>DOI</span><span class="size-4" set:html={icons.external}></span>
            </a>
            <a href={profile.links.scholar} target="_blank" rel="noreferrer" class="tap-target inline-flex items-center gap-2 border-b border-line/35 text-ink-100 transition hover:border-accent-300 hover:text-accent-300">
              <span>Google Scholar</span><span class="size-4" set:html={icons.external}></span>
            </a>
          </div>
        </div>
      </div>
    </article>

    <div class="mt-14">
      <div class="flex flex-col gap-3 border-b border-line/20 pb-6 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="section-index">Secondary research</p>
          <h3 class="mt-3 text-3xl font-medium text-ink-100 md:text-4xl">More publications</h3>
        </div>
        <p class="max-w-md text-sm leading-6 text-ink-300">Additional work across Persian NLP, healthcare AI, speech, biomedical machine learning, and graph learning.</p>
      </div>

      <div class="grid min-w-0 gap-px border-x border-b border-line/20 bg-line/20 md:grid-cols-2">
        {visibleSecondary.map((paper) => (
          <article class="min-w-0 bg-surface-950 p-6 md:p-8">
            <div class="flex flex-wrap items-center justify-between gap-3 text-sm">
              <p class="font-mono text-xs uppercase tracking-[0.12em] text-accent-300">{paper.area}</p>
              <p class="text-ink-300">{paper.citationCount} citations</p>
            </div>
            <h4 class="mt-5 text-2xl font-medium leading-tight text-ink-100">{paper.title}</h4>
            <p class="mt-4 text-sm leading-7 text-ink-300">{paper.summary}</p>
            {paper.figure && (
              <figure class="mt-5 border border-line/20 bg-white p-2">
                <a href={resolveAssetUrl(paper.figure.src)} target="_blank" rel="noreferrer" aria-label="Open the dysgraphia model figure at full size" class="block">
                  <img
                    src={resolveAssetUrl(paper.figure.src)}
                    alt={paper.figure.alt}
                    width={paper.figure.width}
                    height={paper.figure.height}
                    loading="lazy"
                    class="h-auto w-full object-contain"
                  />
                </a>
                <figcaption class="flex flex-wrap justify-between gap-x-4 border-t border-black/15 px-2 pt-3 text-xs leading-5 text-neutral-700">
                  <span>{paper.figure.caption}</span>
                  <a href={resolveAssetUrl(paper.figure.src)} target="_blank" rel="noreferrer" class="inline-flex min-h-11 items-center font-medium underline">Open full size</a>
                </figcaption>
              </figure>
            )}
            {paper.result && <p class="mt-4 border-l-2 border-signal pl-4 text-sm leading-7 text-ink-200">{paper.result}</p>}
            {paper.url && (
              <a href={paper.url} target="_blank" rel="noreferrer" class="tap-target mt-5 inline-flex items-center gap-2 border-b border-line/35 text-sm text-ink-100 transition hover:border-accent-300 hover:text-accent-300">
                <span>Read paper</span><span class="size-4" set:html={icons.external}></span>
              </a>
            )}
          </article>
        ))}
      </div>

      <details class="group border-x border-b border-line/20">
        <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-5 px-5 py-4 text-left marker:hidden md:px-8">
          <span class="font-medium text-ink-100">Complete publication list</span>
          <span class="font-mono text-xs text-accent-300 group-open:hidden">Show {additionalSecondary.length} more +</span>
          <span class="hidden font-mono text-xs text-accent-300 group-open:inline">Hide papers −</span>
        </summary>
        <div class="border-t border-line/20 px-5 md:px-8">
          {additionalSecondary.map((paper, index) => (
            <article class="grid min-w-0 gap-3 border-b border-line/15 py-6 last:border-b-0 md:grid-cols-[3rem_1fr_auto] md:items-start">
              <span class="font-mono text-xs text-ink-400">{String(index + 3).padStart(2, '0')}</span>
              <div class="min-w-0">
                <h4 class="text-lg font-medium text-ink-100">{paper.title}</h4>
                <p class="mt-2 text-sm text-ink-300">{paper.area} · {paper.indicator}</p>
              </div>
              <div class="flex flex-wrap items-center gap-5 text-sm text-ink-300">
                <span>{paper.citationCount} citations</span>
                {paper.url ? (
                  <a href={paper.url} target="_blank" rel="noreferrer" class="tap-target inline-flex items-center text-accent-300">Open paper</a>
                ) : (
                  <span>{paper.ctaLabel}</span>
                )}
              </div>
            </article>
          ))}
        </div>
      </details>
    </div>
  </div>
</section>
