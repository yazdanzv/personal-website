---
import { profile } from '../../config/profile';
import type { PublicationEntry } from '../../config/profile';
import { icons } from '../../lib/icons';
const allPublications: PublicationEntry[] = [...profile.research.featured, ...profile.research.all];
---

<section id="research" class="section-rule py-20 md:py-28">
  <div class="page-shell">
    <header class="grid gap-6 lg:grid-cols-[0.35fr_1fr]" data-reveal>
      <p class="section-index">03 · Research</p>
      <div>
        <h2 class="text-balance text-4xl font-medium text-ink-100 md:text-6xl">Research as a second engineering lens.</h2>
        <p class="mt-6 max-w-3xl text-lg leading-8 text-ink-300">{profile.research.intro}</p>
        <div class="mt-6 flex flex-wrap items-center gap-6 text-sm">
          {profile.publications.stats.map((stat) => (
            <span><strong class="font-mono font-medium text-ink-100">{stat.value}</strong> <span class="text-ink-400">{stat.label}</span></span>
          ))}
          <a href={profile.links.scholar} target="_blank" rel="noreferrer" class="border-b border-accent-300/50 pb-1 text-accent-300">Google Scholar</a>
        </div>
      </div>
    </header>

    <div class="mt-14 grid gap-5 lg:grid-cols-2">
      {profile.research.featured.map((paper, index) => (
        <article class="editorial-panel flex h-full flex-col p-6 md:p-8" data-reveal style={`--reveal-delay:${index * 80}ms`}>
          <div class="flex items-start justify-between gap-5">
            <p class="font-mono text-[10px] uppercase tracking-[0.15em] text-accent-300">{paper.area}</p>
            <p class="font-mono text-xs text-ink-400">{paper.citationCount} citations</p>
          </div>
          <h3 class="mt-6 text-balance text-2xl font-medium leading-tight text-ink-100 md:text-3xl">{paper.title}</h3>
          <p class="mt-5 text-base leading-7 text-ink-300">{paper.summary}</p>
          <dl class="mt-7 grid gap-5 border-t border-white/10 pt-6">
            <div><dt class="font-mono text-[10px] uppercase tracking-[0.15em] text-ink-400">My contribution</dt><dd class="mt-2 text-sm leading-6 text-ink-200">{paper.contribution}</dd></div>
            <div><dt class="font-mono text-[10px] uppercase tracking-[0.15em] text-ink-400">What it shows</dt><dd class="mt-2 text-sm leading-6 text-ink-200">{paper.result}</dd></div>
          </dl>

          {index === 0 ? (
            <div class="technical-grid mt-7 border border-white/10 p-4" aria-label="Simplified Persian sentiment analysis pipeline">
              <div class="grid grid-cols-[1fr_auto_1fr_auto_1fr] items-center gap-2 text-center font-mono text-[9px] uppercase tracking-[0.08em] text-ink-300 sm:text-[10px]">
                <span class="border border-white/15 bg-surface-800 p-3">Persian tweet</span><span class="text-accent-300">→</span><span class="border border-accent-300/30 bg-accent-400/10 p-3">NB + rule hints</span><span class="text-accent-300">→</span><span class="border border-signal/40 bg-signal/10 p-3">BERT result</span>
              </div>
              <div class="mt-4 flex items-center justify-between border-t border-white/10 pt-4 font-mono text-xs"><span class="text-ink-400">BERT baseline 86%</span><span class="text-accent-300">Hybrid model ≈89%</span></div>
            </div>
          ) : (
            <div class="technical-grid mt-7 grid grid-cols-[1fr_auto_1fr] items-center gap-3 border border-white/10 p-4 text-center font-mono text-[10px] uppercase tracking-[0.08em] text-ink-300">
              <span class="border border-white/15 bg-surface-800 p-3">Teacher model</span><span class="text-signal">→</span><span class="border border-signal/40 bg-signal/10 p-3">Compact student</span>
            </div>
          )}

          <div class="mt-auto pt-7">
            <a href={paper.url} target="_blank" rel="noreferrer" class="inline-flex items-center gap-2 border-b border-white/25 pb-1 text-sm text-ink-100 transition hover:border-accent-300 hover:text-accent-300">
              <span>Read paper</span><span class="size-4" set:html={icons.external}></span>
            </a>
          </div>
        </article>
      ))}
    </div>

    <div class="mt-12">
      <button type="button" data-publications-toggle aria-expanded="false" aria-controls="complete-publications" class="flex w-full items-center justify-between border-y border-white/15 py-5 text-left">
        <span class="text-lg font-medium text-ink-100">Complete publication list</span>
        <span class="font-mono text-xs text-accent-300" data-publications-label>Show {allPublications.length} papers +</span>
      </button>
      <div id="complete-publications" data-publications-list hidden>
        {allPublications.map((paper, index) => (
          <article class="grid gap-3 border-b border-white/10 py-6 md:grid-cols-[3rem_1fr_auto] md:items-start">
            <span class="font-mono text-xs text-ink-400">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="text-lg font-medium text-ink-100">{paper.title}</h3>
              <p class="mt-2 font-mono text-[10px] uppercase tracking-[0.13em] text-ink-400">{paper.area} · {paper.indicator}</p>
            </div>
            <div class="flex items-center gap-4 text-sm text-ink-400">
              <span>{paper.citationCount} citations</span>
              {paper.url ? <a href={paper.url} target="_blank" rel="noreferrer" class="text-accent-300">Open</a> : <span>{paper.ctaLabel}</span>}
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>

  <script>
    const toggle = document.querySelector('[data-publications-toggle]');
    const list = document.querySelector('[data-publications-list]');
    const label = document.querySelector('[data-publications-label]');
    if (toggle instanceof HTMLButtonElement && list instanceof HTMLElement) {
      toggle.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') !== 'true';
        toggle.setAttribute('aria-expanded', String(open));
        list.toggleAttribute('hidden', !open);
        if (label instanceof HTMLElement) label.textContent = open ? 'Hide papers −' : `Show ${list.children.length} papers +`;
      });
    }
  </script>
</section>
