---
import { profile } from '../../config/profile';
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-surface-950/90 backdrop-blur-xl">
  <div class="page-shell flex min-h-20 items-center justify-between gap-5">
    <a href={`${import.meta.env.BASE_URL}#home`} class="group flex min-w-0 items-center gap-3" aria-label={`${profile.name}, home`}>
      <span class="flex h-9 w-9 shrink-0 items-center justify-center border border-accent-300/50 font-mono text-xs font-medium text-accent-300">YZ</span>
      <span class="min-w-0">
        <span class="block truncate text-sm font-semibold text-ink-100">{profile.name}</span>
        <span class="hidden truncate font-mono text-[10px] uppercase tracking-[0.13em] text-ink-400 sm:block">Full-stack engineer · Vienna</span>
      </span>
    </a>

    <nav class="hidden items-center gap-6 lg:flex" aria-label="Primary navigation">
      {profile.navigation.map((item) => (
        <a href={`${import.meta.env.BASE_URL}${item.href}`} class="text-sm text-ink-300 transition hover:text-ink-100">{item.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a href={`${import.meta.env.BASE_URL}${profile.links.cv}`} download="Yazdan-Zandiye-Vakili-Resume.pdf" class="hidden border-b border-accent-300/60 pb-1 text-sm font-medium text-accent-300 transition hover:border-accent-300 sm:inline-flex">Résumé</a>
      <button type="button" data-mobile-menu-toggle aria-expanded="false" aria-controls="mobile-navigation" aria-label="Open navigation menu" class="flex h-11 w-11 items-center justify-center border border-white/15 text-ink-100 lg:hidden">
        <span class="relative h-4 w-5" aria-hidden="true">
          <span class="absolute left-0 top-0 h-px w-5 bg-current transition" data-menu-line-top></span>
          <span class="absolute left-0 top-[7px] h-px w-5 bg-current transition" data-menu-line-middle></span>
          <span class="absolute left-0 top-[14px] h-px w-5 bg-current transition" data-menu-line-bottom></span>
        </span>
      </button>
    </div>
  </div>

  <div id="mobile-navigation" data-mobile-menu class="border-t border-white/10 bg-surface-950 px-4 py-4 lg:hidden" hidden>
    <nav class="page-shell grid" aria-label="Mobile navigation">
      {profile.navigation.map((item, index) => (
        <a href={`${import.meta.env.BASE_URL}${item.href}`} data-mobile-nav-link class="flex items-center justify-between border-b border-white/10 py-4 text-base text-ink-200">
          <span>{item.label}</span><span class="font-mono text-xs text-ink-400">0{index + 1}</span>
        </a>
      ))}
      <a href={`${import.meta.env.BASE_URL}${profile.links.cv}`} download="Yazdan-Zandiye-Vakili-Resume.pdf" class="mt-5 inline-flex w-fit border-b border-accent-300/60 pb-1 text-sm font-medium text-accent-300">Download résumé</a>
    </nav>
  </div>

  <script>
    const menu = document.querySelector('[data-mobile-menu]');
    const toggle = document.querySelector('[data-mobile-menu-toggle]');
    const links = document.querySelectorAll('[data-mobile-nav-link]');
    const lines = {
      top: document.querySelector('[data-menu-line-top]'),
      middle: document.querySelector('[data-menu-line-middle]'),
      bottom: document.querySelector('[data-menu-line-bottom]'),
    };

    const setOpen = (open: boolean) => {
      if (!(menu instanceof HTMLElement) || !(toggle instanceof HTMLButtonElement)) return;
      menu.toggleAttribute('hidden', !open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
      if (lines.top instanceof HTMLElement) lines.top.style.transform = open ? 'translateY(7px) rotate(45deg)' : '';
      if (lines.middle instanceof HTMLElement) lines.middle.style.opacity = open ? '0' : '1';
      if (lines.bottom instanceof HTMLElement) lines.bottom.style.transform = open ? 'translateY(-7px) rotate(-45deg)' : '';
    };

    if (toggle instanceof HTMLButtonElement) toggle.addEventListener('click', () => setOpen(menu instanceof HTMLElement && menu.hasAttribute('hidden')));
    links.forEach((link) => link.addEventListener('click', () => setOpen(false)));
    window.addEventListener('keydown', (event) => { if (event.key === 'Escape') setOpen(false); });
  </script>
</header>
